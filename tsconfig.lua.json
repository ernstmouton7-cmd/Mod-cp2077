{
  "$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/master/tsconfig-schema.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": ".",
    "outDir": "build/lua"
  },
  "tstl": {
    "luaTarget": "5.1",
    "luaBundle": "gridlock_core.lua",
    "luaBundleEntry": "src/core/index.ts",
    "noImplicitSelf": true,
    "noHeader": false
  },
  "include": ["src/core"]
}
